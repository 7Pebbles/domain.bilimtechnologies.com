PORT=3000
APP_URL=https://domains.bilimtechnologies.in
REMINDER_EMAIL=admin@bilimtechnologies.in
REMINDER_DAYS=60,30,14,7,3,1
CHECK_INTERVAL_HOURS=24

# Turso database credentials: https://turso.tech
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# Protects scheduled Vercel Cron endpoints. Generate with: openssl rand -hex 32
CRON_SECRET=

# Optional HTTP Basic Auth. Set both values before exposing the dashboard.
ADMIN_USER=
ADMIN_PASSWORD=

# SMTP credentials are required for email reminders.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Bilim Domain Watch <domains@bilimtechnologies.in>"

# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bilimtechnologies.in
